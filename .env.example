NODE_ENV=production
PORT=10000
CORS_ORIGINS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=church-public
SUPABASE_PRIVATE_BUCKET=church-private

# Optional independent off-site backups
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Existing admin passwords are not reset on each deploy by default.
# Set true only for a deliberate one-time sync from ICF_ADMIN_PASSWORD.
ICF_ADMIN_SYNC_PASSWORD=false
